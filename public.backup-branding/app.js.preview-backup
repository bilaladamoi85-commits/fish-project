          </span>
        </button>

        <div class="voice-card-actions">

          <button
            type="button"
            class="voice-card-preview"
            data-voice-preview="${esc(id)}"
            aria-label="Preview ${esc(title)}"
            title="Preview"
          >
            <svg class="preview-play-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <circle cx="24" cy="24" r="18"
                stroke="currentColor" stroke-width="2.4"/>
              <path d="M20 16.5v15l12-7.5-12-7.5Z"
                fill="currentColor"/>
            </svg>
            <svg class="preview-loading-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <circle cx="24" cy="24" r="17"
                stroke="currentColor" stroke-width="3"
                stroke-linecap="round"
