const API = location.origin;
let voices = [];
let page = 1;
const pageSize = 50;
let hasMore = true;
let selectedEmotion = "neutral";
let cinematicMode = localStorage.getItem("fish.cinematicMode") === "1";
let generatedAudioUrl = "";
let searchTimer = null;
let generationPoller = null;
let generationCountdownTimer = null;
let generationRemaining = 120;

const $ = id => document.getElementById(id);

document.addEventListener("DOMContentLoaded", () => {
  updateCounter();
  setupEvents();
  // cinematicMode يتعالج من الواجهة مباشرة
  checkHealth();

  // Recent voices تظهر مباشرة.
  // ممنوع تحميل قائمة Fish عند فتح الصفحة.
  try {
    renderRecentVoices();
    renderVoiceSearchResults();
  } catch (e) {
    console.warn("recent voices:", e);
  }
loadClonedVoices();

  const savedEmotion = localStorage.getItem("fish.emotion");
  if (savedEmotion) {
    selectedEmotion = savedEmotion;
    document.querySelectorAll(".emotion").forEach(btn => {
      btn.classList.toggle(
        "active",
        btn.dataset.emotion === selectedEmotion
      );
    });
  }

  resumeActiveJob();
});

function setupEvents() {
  $("textInput")?.addEventListener("input", updateCounter);

  document.querySelectorAll(".emotion").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".emotion").forEach(x => x.classList.remove("active"));
      btn.classList.add("active");
      selectedEmotion = btn.dataset.emotion;
    localStorage.setItem('fish_selected_emotion', selectedEmotion);
    });
  });

  $("voiceSearch")?.addEventListener("input", () => {
    clearTimeout(searchTimer);

    const input = $("voiceSearch");
    const query = input?.value?.trim() || "";

    if (!query) {
      voices = getRecentVoices().filter(v => v && v.id);
      renderRecentVoices();
      renderVoiceSearchResults();

      const select = $("voiceSelect");
      if (select) {
        select.innerHTML = '<option value="">اختار صوت من البحث</option>';
      }

      const status = $("voiceStatus");
      if (status) status.textContent = "";

      return;
    }

    searchTimer = setTimeout(() => {
      loadVoices(true).catch(e => console.error("voice search:", e));
    }, 300);
  });

  $("languageSelect")?.addEventListener("change", () => loadVoices(true));
  $("loadMoreBtn")?.addEventListener("click", () => loadVoices(false));
  $("refreshBtn")?.addEventListener("click", () => loadVoices(true));

  setupVoiceFilters();
}

async function checkHealth() {
  try {
    const r = await fetch(`${API}/api/health`);
    const d = await r.json();

    $("healthStatus").textContent = d.fishConfigured
      ? "🟢 Fish Audio connected"
      : "🔴 Fish Audio API key missing";

    $("healthStatus").className = d.fishConfigured
      ? "status ok"
      : "status error";
  } catch {
    $("healthStatus").textContent = "🔴 Server unavailable";
    $("healthStatus").className = "status error";
  }
}


async function loadVoices(reset = false) {
  const search = $("voiceSearch")?.value?.trim() || "";

  // لا يوجد بحث = لا يوجد request إلى Fish.
  if (!search) {
    voices = getRecentVoices().filter(v => v && v.id);
    renderRecentVoices();
    renderVoiceSearchResults();

    const select = $("voiceSelect");
    if (select) {
      select.innerHTML = '<option value="">اختار صوت من البحث</option>';
    }

    const status = $("voiceStatus");
    if (status) status.textContent = "";

    return;
  }

  if (reset) {
    page = 1;
    hasMore = true;
    voices = getRecentVoices().filter(v => v && v.id);
  }

  if (!hasMore && !reset) return;

  const loadMoreBtn = $("loadMoreBtn");
  if (loadMoreBtn) {
    loadMoreBtn.disabled = true;
    loadMoreBtn.textContent = "⏳ Loading...";
  }

  try {
    const params = new URLSearchParams({
      page: page,
      pageSize: pageSize,
      search: search
    });

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);

    let r;
    try {
      r = await fetch(`${API}/api/voices?${params}`, {
        signal: controller.signal,
        cache: "no-store"
      });
    } finally {
      clearTimeout(timeout);
    }

    if (!r.ok) throw new Error("Voice request failed");

    const data = await r.json();
    const items = data.voices || data.models || data.items || [];

    const existing = new Set(voices.map(v => String(v.id)));

    for (const v of items) {
      if (v.id && !existing.has(String(v.id))) {
        voices.push(v);
      }
    }

    hasMore = Boolean(data.hasMore) || items.length >= pageSize;
    page++;

    renderVoices();
    renderVoiceSearchResults();

    const status = $("voiceStatus");
    if (status) status.textContent = "";
  } catch (e) {
    const status = $("voiceStatus");
    if (status) {
      status.textContent =
        e.name === "AbortError"
          ? "⚠️ البحث تأخر، حاول مرة أخرى"
          : "❌ تعذر البحث عن الأصوات";
    }

    renderRecentVoices();
  } finally {
    if (loadMoreBtn) {
      loadMoreBtn.disabled = !hasMore;
      loadMoreBtn.textContent = hasMore ? "⬇️" : "✅";
    }
  }
}

function renderVoices() {
  const select = $("voiceSelect");
  const previous = select.value;

  select.innerHTML = "";

  if (!voices.length) {
    select.innerHTML = `<option value="">No voices found</option>`;
    $("voiceInfo").textContent = "";
    return;
  }

  voices.forEach((v, i) => {
    const option = document.createElement("option");
    option.value = v.id || "";
    option.textContent =
      v.title ||
      v.name ||
      `Voice ${i + 1}`;
    select.appendChild(option);
  });

  const savedVoice = localStorage.getItem("fish.voiceId");

  if (savedVoice && voices.some(v => v.id === savedVoice)) {
    select.value = savedVoice;
  } else if (voices.some(v => v.id === previous)) {
    select.value = previous;
  }

  showVoiceInfo();
  renderRecentVoices();
  renderVoiceSearchResults();

  select.onchange = () => {
    showVoiceInfo();

    if (select.value) {
      localStorage.setItem("fish.voiceId", select.value);
      rememberRecentVoice(select.value);
    }

    renderRecentVoices();
  };
}

/* ===== Voice Search Results with Save Buttons ===== */
function voiceText(v) {
  return [
    v.title,
    v.name,
    v.nickname,
    v.gender,
    v.sex,
    v.language,
    v.languages,
    v.country,
    v.countryCode,
    v.country_code,
    v.tags,
    v.labels,
    v.category,
    v.style
  ].flat().filter(Boolean).join(" ").toLowerCase();
}

function voiceGender(v) {
  const x = voiceText(v);
  if (/\b(female|woman|girl|fem|womanly|lady)\b/.test(x)) return "female";
  if (/\b(male|man|boy|masc|gentleman)\b/.test(x)) return "male";
  return "";
}

function voiceCountry(v) {
  return String(
    v.country ||
    v.countryName ||
    v.country_code ||
    v.countryCode ||
    ""
  ).trim();
}

function voiceStyles(v) {
  const raw = [
    v.style,
    v.styles,
    v.category,
    v.categories,
    v.tags,
    v.labels
  ].flat().filter(Boolean);

  return raw
    .flatMap(x => String(x).split(/[,\|;]+/))
    .map(x => x.trim())
    .filter(Boolean)
    .slice(0, 6);
}

function voiceLanguage(v) {
  return String(
    v.language ||
    v.lang ||
    v.locale ||
    (Array.isArray(v.languages) ? v.languages[0] : v.languages) ||
    ""
  ).trim();
}

function renderVoiceFilters(items) {
  const countrySelect = $("voiceCountrySelect");
  const languageSelect = $("voiceLanguageSelect");
  const genderSelect = $("voiceGenderSelect");

  if (!countrySelect || !languageSelect || !genderSelect) return;

  const oldCountry = countrySelect.value;
  const oldLanguage = languageSelect.value;
  const oldGender = genderSelect.value;

  const countries = [...new Set(
    items.map(voiceCountry).filter(Boolean)
  )].sort();

  const languages = [...new Set(
    items.map(voiceLanguage).filter(Boolean)
  )].sort();

  countrySelect.innerHTML =
    '<option value="">كل الدول</option>';

  countries.forEach(c => {
    const o = document.createElement("option");
    o.value = c;
    o.textContent = c;
    countrySelect.appendChild(o);
  });

  languageSelect.innerHTML =
    '<option value="">كل اللغات</option>';

  languages.forEach(l => {
    const o = document.createElement("option");
    o.value = l;
    o.textContent = l;
    languageSelect.appendChild(o);
  });

  if (countries.includes(oldCountry))
    countrySelect.value = oldCountry;

  if (languages.includes(oldLanguage))
    languageSelect.value = oldLanguage;

  genderSelect.value = oldGender;
}

function setupVoiceFilters() {
  ["voiceCountrySelect", "voiceLanguageSelect", "voiceGenderSelect"].forEach(id => {
    const el = $(id);
    if (el) {
      el.addEventListener("change", () => {
        renderVoiceSearchResults();
      });
    }
  });
}

