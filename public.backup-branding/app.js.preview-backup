async function submitVoiceClone() {
  const title = $("voiceTitle").value.trim();
  const audioUrls = [...document.querySelectorAll(".audio-url-input")]
    .map(x => x.value.trim())
    .filter(Boolean);

  if (!title || !audioUrls.length) {
    alert("دخل اسم الصوت ورابط صوت واحد على الأقل.");
    return;
  }

  try {
    const r = await fetch(`${API}/api/clone-voice`, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({title, audioUrls})
    });

    const d = await r.json();

    if (!r.ok) throw new Error(d.error || "Clone failed");

    hideCloneForm();
    await loadClonedVoices();

  const savedEmotion =
    localStorage.getItem("fish.emotion");

  if (savedEmotion) {
    selectedEmotion = savedEmotion;
    document.querySelectorAll(".emotion").forEach(btn => {
      btn.classList.toggle(
        "active",
        btn.dataset.emotion === selectedEmotion
      );
    });
  }

  resumeActiveJob();
    showStatus("✅ تم إنشاء الصوت المستنسخ", "success");
  } catch (e) {
    showStatus("❌ " + e.message, "error");
  }
}

/* =========================================================
   Professional voice selection effect
   ========================================================= */
(function setupProfessionalVoiceSelection() {

  function clearSelected() {
    document
      .querySelectorAll(
        ".voice-card.voice-is-selected, .recent-voice-item.voice-is-selected"
      )
      .forEach(el => el.classList.remove("voice-is-selected"));
  }

  function markSelected(el) {
    if (!el) return;

    clearSelected();

    const card = el.closest(".voice-card, .recent-voice-item");

    if (card) {
      card.classList.add("voice-is-selected");

      setTimeout(() => {
        card.classList.add("voice-is-selected");
      }, 20);
    }
  }

  document.addEventListener("click", event => {

    const card = event.target.closest(
      ".voice-card, .recent-voice-main, .recent-voice-item"
    );

    if (!card) return;

    /* ما نطبقوش التأثير على زر الحذف */
    if (
      event.target.closest(".recent-voice-delete") ||
      event.target.closest(".voice-card-save")
    ) {
      return;
    }

    markSelected(card);
  });

  /* إذا كان صوت محفوظ بالفعل مختار */
  const savedId = localStorage.getItem("fish.voiceId");

  if (savedId) {
    setTimeout(() => {
      const cards = document.querySelectorAll(
        ".voice-card, .recent-voice-item"
      );

      cards.forEach(card => {
        const id =
          card.dataset.voiceId ||
          card.querySelector("[data-voice-id]")?.dataset.voiceId ||
          card.querySelector("[data-recent-select]")?.dataset.recentSelect;

        if (id && String(id) === String(savedId)) {
          card.classList.add("voice-is-selected");
        }
      });
    }, 100);
  }

})();


