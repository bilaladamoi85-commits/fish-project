    '🚀 Fish Audio Voice App'
  );
  console.log(
    `🌐 http://localhost:${PORT}`
  );
  console.log(
    `⚡ Parallel TTS: ${PARALLEL}`
  );
  console.log(
    `✂️ Chunk size: ${CHUNK_SIZE}`
  );
  console.log('');
});
