<script id="cinematic-inline-control">
(function () {
  function refreshCinematicButton() {
    const btn = document.getElementById("cinematicModeBtn");
    if (!btn) return;

    const enabled = localStorage.getItem("fish.cinematicMode") === "1";

    btn.classList.toggle("active", enabled);
    btn.setAttribute("aria-pressed", enabled ? "true" : "false");

    const state = btn.querySelector(".cinematic-state");
    if (state) state.textContent = enabled ? "مفعل" : "متوقف";
  }

  function toggleCinematicMode() {
    const enabled = localStorage.getItem("fish.cinematicMode") === "1";
    localStorage.setItem("fish.cinematicMode", enabled ? "0" : "1");
    refreshCinematicButton();
  }

  function initCinematicButton() {
    const btn = document.getElementById("cinematicModeBtn");
    if (!btn || btn.dataset.cinematicReady === "1") return;

    btn.dataset.cinematicReady = "1";

    btn.addEventListener("click", function () {
      toggleCinematicMode();
    });

    refreshCinematicButton();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCinematicButton);
  } else {
    initCinematicButton();
  }
})();
</script>

