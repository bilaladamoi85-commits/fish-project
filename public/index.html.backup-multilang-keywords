  const deviceLang = (navigator.language || "en").toLowerCase();

  const lang =
    Object.keys(translations).find(
      x => deviceLang === x || deviceLang.startsWith(x + "-")
    ) || "en";

  const dict = translations[lang];

  document.documentElement.lang = lang;
  document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";

  function translate(root = document.body) {
    if (!root) return;

    const walker = document.createTreeWalker(
      root,
      NodeFilter.SHOW_TEXT,
      null
    );

    const nodes = [];

    while (walker.nextNode()) {
      const node = walker.currentNode;
      const parent = node.parentElement;

      if (!parent) continue;

      if (
        ["SCRIPT", "STYLE", "NOSCRIPT"].includes(parent.tagName)
      ) {
        continue;
      }

      nodes.push(node);
    }

    for (const node of nodes) {
      const text = node.nodeValue;

      for (const [source, target] of Object.entries(dict)) {
        if (text.includes(source)) {
          node.nodeValue = node.nodeValue.split(source).join(target);
        }
      }
    }

    root.querySelectorAll?.(
      "input[placeholder], textarea[placeholder]"
    ).forEach(el => {
      const value = el.getAttribute("placeholder");

      if (value && dict[value]) {
        el.setAttribute("placeholder", dict[value]);
      }
    });

    root.querySelectorAll?.(
      "input[aria-label], button[aria-label]"
    ).forEach(el => {
      const value = el.getAttribute("aria-label");

      if (value && dict[value]) {
        el.setAttribute("aria-label", dict[value]);
      }
    });
  }

  function start() {
    translate();

    const observer = new MutationObserver(mutations => {
      for (const mutation of mutations) {
        for (const node of mutation.addedNodes) {
          if (node.nodeType === Node.ELEMENT_NODE) {
            translate(node);
          }
        }
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    console.log("SpeakOra language:", lang);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
