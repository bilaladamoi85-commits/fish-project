function previewVoice(id, button) {
  if (!id || !button) return;

  if (button.dataset.previewing === "1") return;

  button.dataset.previewing = "1";
  const oldText = button.innerHTML;

  button.disabled = true;
  button.innerHTML = "⏳";

  fetch("/api/voice-preview", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      voiceId: id
    })
  })
    .then(async response => {
      const data = await response.json().catch(() => ({}));

      if (!response.ok || !data.ok || !data.audioUrl) {
        throw new Error(data.error || "Preview failed");
      }

      return data;
    })
    .then(data => {
      const audio = new Audio(data.audioUrl);

      button.innerHTML = "▶";

      audio.play().catch(err => {
        console.warn("Preview playback blocked:", err);
      });

      audio.addEventListener("ended", () => {
        if (button.isConnected) {
          button.innerHTML = oldText;
        }
      });

      audio.addEventListener("error", () => {
        if (button.isConnected) {
          button.innerHTML = oldText;
        }
      });
    })
    .catch(err => {
      console.error("Voice preview:", err);

      if (button.isConnected) {
        button.innerHTML = "⚠️";

        setTimeout(() => {
          if (button.isConnected) {
            button.innerHTML = oldText;
          }
        }, 1200);
      }
    })
    .finally(() => {
      if (button.isConnected) {
        button.disabled = false;
        button.dataset.previewing = "0";
      }
    });
}

function renderVoiceSearchResults() {
  const input = document.getElementById("voiceSearch");
  const box = document.getElementById("voiceSearchResultsBox");
  const count = document.getElementById("voiceResultCount");

  if (!box) return;

  renderSelectedVoice();

  const query = input
    ? input.value.trim().toLowerCase()
    : "";

  if (count) count.textContent = "";

  if (!query) {
    box.innerHTML = "";
    box.style.display = "none";
    renderRecentVoices();
    renderSelectedVoice();
    return;
  }

  const countryFilter =
    document.getElementById("voiceCountrySelect")?.value || "";

  const genderFilter =
    document.getElementById("voiceGenderSelect")?.value || "";

  const styleFilter =
    document.getElementById("voiceStyleSelect")?.value || "";

  const matches = voices.filter(v => {
    const textMatch = voiceText(v).includes(query);

    const country = voiceCountry(v);
    const gender = voiceGender(v);
    const styles = voiceStyles(v);

    const countryMatch =
      !countryFilter ||
      country === countryFilter;

    const genderMatch =
      !genderFilter ||
      gender === genderFilter;

    const styleMatch =
      !styleFilter ||
      styles.some(x =>
        String(x).toLowerCase() ===
        String(styleFilter).toLowerCase()
      );

    return (
      textMatch &&
      countryMatch &&
      genderMatch &&
      styleMatch
    );
  });

  const select = document.getElementById("voiceSelect");
  const selectedId = select
    ? String(select.value || "")
    : "";

  if (count) {
    count.textContent = `${matches.length} voices`;
  }

  if (!matches.length) {
    box.innerHTML =
      '<div class="voice-no-results">No voices found</div>';

    box.style.display = "";
    return;
  }

  box.innerHTML = matches.map(v => {
    const id = String(v.id || "");

    const title =
      v.title ||
      v.name ||
      v.nickname ||
      "Voice";

    const lang = voiceLanguage(v);
    const country = voiceCountry(v);
    const gender = voiceGender(v);
    const styles = voiceStyles(v);

    const tags = [];

    if (lang) tags.push(`🌐 ${lang}`);
    if (country) tags.push(`🌍 ${country}`);
    if (gender) tags.push(`👤 ${gender}`);

    styles.slice(0, 2).forEach(x => {
      if (x) tags.push(`🎭 ${x}`);
    });

    const tagsHtml = tags
      .slice(0, 6)
      .map(x =>
        `<span class="voice-card-tag">${esc(x)}</span>`
      )
      .join("");

    const selected =
      id === selectedId;

    return `
      <div
        class="voice-card ${selected ? "selected" : ""}"
        data-voice-id="${esc(id)}"
        style="
          position:relative;
          display:flex;
          align-items:stretch;
          gap:7px;
        "
      >

        <button
          type="button"
          class="voice-card-main"
          data-voice-select="${esc(id)}"
          style="
            flex:1;
            min-width:0;
          "
        >
          <div class="voice-card-icon">
            ${voiceAvatarHTML(v, title)}
          </div>

          <div class="voice-card-body">
            <div class="voice-card-name">
              ${esc(title)}
              ${
                selected
                  ? '<span class="voice-card-check">✓</span>'
                  : ""
              }
            </div>

            <div class="voice-card-tags">
              ${tagsHtml}
            </div>
          </div>
        </button>

        <div style="
          display:flex;
          flex-direction:column;
          gap:5px;
          padding:5px 5px 5px 0;
        ">

          <button
            type="button"
            data-voice-preview="${esc(id)}"
            title="Preview voice"
            aria-label="Preview voice"
            style="
              width:38px;
              height:34px;
              border:0;
              border-radius:9px;
              cursor:pointer;
              font-size:16px;
            "
          >▶</button>

          <button
            type="button"
            class="voice-card-save"
            data-voice-save="${esc(id)}"
            title="Save voice"
            aria-label="Save voice"
            style="
              width:38px;
              height:30px;
              border:0;
              border-radius:8px;
              cursor:pointer;
            "
          >💾</button>

        </div>
      </div>
    `;
  }).join("");

  box.style.display = "";

  // =========================
  // PREVIEW
  // =========================
  box.querySelectorAll("[data-voice-preview]").forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      e.stopPropagation();

      const id =
        btn.getAttribute("data-voice-preview");

      previewVoice(id, btn);
    });
  });

  // =========================
  // SAVE
  // =========================
  box.querySelectorAll("[data-voice-save]").forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      e.stopPropagation();

      const id =
        btn.getAttribute("data-voice-save");

      if (!id) return;

      rememberRecentVoice(id);
      renderRecentVoices();

      btn.textContent = "✓";

      setTimeout(() => {
        if (btn.isConnected) {
          btn.textContent = "💾";
        }
      }, 900);
    });
  });

  // =========================
  // SELECT
  // =========================
  box.querySelectorAll("[data-voice-select]").forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();

      const id =
        btn.getAttribute("data-voice-select");

      if (!id) return;

      const select =
        document.getElementById("voiceSelect");

      if (!select) return;

      const v =
        voices.find(x =>
          String(x.id) === String(id)
        );

      let option =
        [...select.options].find(
          o => o.value === id
        );

      if (!option && v) {
        option = new Option(
          v.title ||
          v.name ||
          v.nickname ||
          "Voice",
          id
        );

        select.add(option);
      }

      select.value = id;

      localStorage.setItem(
        "fish.voiceId",
        id
      );

      // This keeps all existing app logic alive.
      select.dispatchEvent(
        new Event("change", {
          bubbles: true
        })
      );

      rememberRecentVoice(id);
      renderRecentVoices();
      renderSelectedVoice();
      renderVoiceSearchResults();
    });
  });
}

/* ===== Recent Voices ===== */
const RECENT_VOICES_KEY = "fish.recentVoices";
const RECENT_VOICES_MAX = 10;

function getRecentVoices() {
  try {
    const data = JSON.parse(localStorage.getItem(RECENT_VOICES_KEY) || "[]");
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
}

function rememberRecentVoice(id) {
  if (!id) return;

  const voice = voices.find(v => v.id === id);
  if (!voice) return;

  const item = {
    ...voice,
    id: voice.id,
    title: voice.title || voice.name || voice.nickname || "Voice"
  };

  let recent = getRecentVoices();

  recent = recent.filter(v => v.id !== item.id);
  recent.unshift(item);
  recent = recent.slice(0, RECENT_VOICES_MAX);

  localStorage.setItem(RECENT_VOICES_KEY, JSON.stringify(recent));
}



function renderRecentVoices() {
  const recent = getRecentVoices();

  let box = document.getElementById("recentVoicesBox");

  if (!box) {
    box = document.createElement("div");
    box.id = "recentVoicesBox";
    box.className = "recent-voices-box";

    const searchBox = document.getElementById("voiceSearchResultsBox");

    if (searchBox && searchBox.parentNode) {
      searchBox.parentNode.insertBefore(box, searchBox);
    } else {
      const voiceSearch = document.getElementById("voiceSearch");
      if (voiceSearch && voiceSearch.parentNode) {
        voiceSearch.parentNode.appendChild(box);
      }
    }
  }

  if (!recent.length) {
    box.innerHTML = "";
    box.style.display = "none";
    return;
  }


  box.innerHTML = `
    <div class="recent-voices-title">🕘 آخر الأصوات المحفوظة</div>
    <div class="recent-voices-list">
      ${recent.map(v => `
        <div class="recent-voice-item" data-recent-id="${esc(v.id)}">
          <button type="button"
                  class="recent-voice-main"
                  data-recent-select="${esc(v.id)}">
            <span class="recent-voice-icon">🎙️</span>
            <span class="recent-voice-name">${esc(v.title || v.name || "Voice")}</span>
          </button>
          <button type="button"
                  class="recent-voice-delete"
                  data-recent-delete="${esc(v.id)}">×</button>
        </div>
      `).join("")}
    </div>
  `;

  box.style.display = "";

  box.querySelectorAll("[data-recent-select]").forEach(btn => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-recent-select");
      const saved = getRecentVoices().find(v => String(v.id) === String(id));
      if (!saved) return;

      const select = document.getElementById("voiceSelect");
      if (select) {
        let option = [...select.options].find(o => String(o.value) === String(id));

        if (!option) {
          option = new Option(
            saved.title || saved.name || saved.nickname || "Voice",
            saved.id
          );
          select.add(option);
        }

        select.value = saved.id;
        localStorage.setItem("fish.voiceId", saved.id);
        select.dispatchEvent(new Event("change", { bubbles: true }));
      }

      renderRecentVoices();
    });
  });

  box.querySelectorAll("[data-recent-delete]").forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      e.stopPropagation();

      const id = btn.getAttribute("data-recent-delete");

      const updated = getRecentVoices().filter(
        v => String(v.id) !== String(id)
      );

      localStorage.setItem(
        RECENT_VOICES_KEY,
        JSON.stringify(updated)
      );

      renderRecentVoices();
    });
  });
}

