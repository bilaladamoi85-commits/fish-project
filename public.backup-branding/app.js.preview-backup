async function previewVoice(voice, button) {
  if (!voice || !voice.id || !button) return;

  const name =
    voice.title ||
    voice.name ||
    voice.nickname ||
    "Voice";

  // Fish Audio uses the voice itself to determine the voice/language.
  // We only send the actual voice name as preview text.
  const text = name;

  if (button.dataset.previewBusy === "1") return;

  button.dataset.previewBusy = "1";
  button.disabled = true;
  button.classList.add("is-playing");

  try {
    const response = await fetch(`${API}/api/tts`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        text,
        voiceId: voice.id,
        emotion: "neutral"
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "Preview failed");
    }

    const jobId = data.jobId || data.id;

    if (!jobId) {
      throw new Error("No preview job");
    }

    let audioUrl = data.audioUrl || "";

    for (let i = 0; i < 180; i++) {
      await new Promise(resolve => setTimeout(resolve, 350));

      const r = await fetch(
        `${API}/api/tts-progress/${encodeURIComponent(jobId)}`,
        { cache: "no-store" }
      );

      if (!r.ok) continue;

      const p = await r.json();

      if (p.failed) {
        throw new Error(p.error || "Preview failed");
      }

      if (p.audioUrl) {
        audioUrl = p.audioUrl;
      }

      if (p.finished) {
        break;
      }
    }

    if (!audioUrl) {
      audioUrl = `${API}/api/audio/${encodeURIComponent(jobId)}`;
    }

    const audio = new Audio(audioUrl);
    audio.preload = "auto";

    await audio.play();

    audio.addEventListener("ended", () => {
      button.disabled = false;
      button.dataset.previewBusy = "0";
      button.classList.remove("is-playing");
    }, { once: true });

    audio.addEventListener("error", () => {
      button.disabled = false;
      button.dataset.previewBusy = "0";
      button.classList.remove("is-playing");
    }, { once: true });

  } catch (err) {
    console.error("Voice preview:", err);

    button.disabled = false;
    button.dataset.previewBusy = "0";
    button.classList.remove("is-playing");
  }
}


function selectVoiceFromLibrary(id) {
  const voice = voices.find(v => String(v.id) === String(id));
  if (!voice) return;

  const select = document.getElementById("voiceSelect");

  if (select) {
    let option = [...select.options]
      .find(o => String(o.value) === String(id));

    if (!option) {
      option = new Option(
        voice.title ||
        voice.name ||
        voice.nickname ||
        voice.display_name ||
        "Voice",
        voice.id
      );

      select.add(option);
    }

    select.value = voice.id;
    localStorage.setItem("fish.voiceId", voice.id);

    select.dispatchEvent(
      new Event("change", { bubbles: true })
    );
  }

  rememberRecentVoice(id);

  document
    .querySelectorAll(".voice-card.voice-is-selected")
    .forEach(x => x.classList.remove("voice-is-selected"));

  const card = document.querySelector(
    `.voice-card[data-voice-id="${CSS.escape(String(id))}"]`
  );

  if (card) {
    card.classList.add("voice-is-selected");
  }

  renderRecentVoices();
}

async function previewVoice(voice) {
  if (!voice || !voice.id) return;

  const name =
    voice.title ||
    voice.name ||
    voice.nickname ||
    "Voice";

  const rawLang =
    voice.language ||
    voice.lang ||
    voice.locale ||
    voice.language_code ||
    voice.languageCode ||
    "";

  const lang = String(rawLang).toLowerCase();

  // Use the voice's own language for the preview.
  let previewText = name;
  let previewLanguage = "en";

  if (lang.includes("ar") || lang.includes("arab")) {
    previewLanguage = "ar";
  } else if (lang.includes("fr") || lang.includes("french")) {
    previewLanguage = "fr";
  } else if (lang.includes("es") || lang.includes("spanish")) {
    previewLanguage = "es";
  } else if (lang.includes("de") || lang.includes("german")) {
    previewLanguage = "de";
  } else if (lang.includes("it") || lang.includes("italian")) {
    previewLanguage = "it";
  } else if (lang.includes("pt") || lang.includes("portugu")) {
    previewLanguage = "pt";
  } else if (lang.includes("tr") || lang.includes("turk")) {
    previewLanguage = "tr";
  } else if (lang.includes("nl") || lang.includes("dutch")) {
    previewLanguage = "nl";
  } else if (lang.includes("ja") || lang.includes("japan")) {
    previewLanguage = "ja";
  } else if (lang.includes("ko") || lang.includes("korean")) {
    previewLanguage = "ko";
  } else if (lang.includes("zh") || lang.includes("chinese")) {
    previewLanguage = "zh";
  }

  const buttons = document.querySelectorAll(".voice-card-preview");
  buttons.forEach(b => {
    b.disabled = true;
    b.classList.add("is-playing");
  });

  try {
    const response = await fetch(`${API}/api/tts`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        text: previewText,
        voiceId: voice.id,
        emotion: "neutral",
        preview: true,
        language: previewLanguage
      })
    });

    if (!response.ok) {
      throw new Error("Preview request failed");
    }

    const data = await response.json();
    const jobId = data.jobId || data.id || data.job?.id;

    if (!jobId) {
      throw new Error("No preview job id");
    }

    let audioUrl =
      data.audioUrl ||
      data.url ||
      data.audio ||
      `/api/audio/${encodeURIComponent(jobId)}`;

    let done = false;

    for (let i = 0; i < 180 && !done; i++) {
      await new Promise(r => setTimeout(r, 350));

      const r = await fetch(
        `${API}/api/tts-progress/${encodeURIComponent(jobId)}`
      );

      if (!r.ok) continue;

      const progress = await r.json();

      if (
        progress.audioUrl ||
        progress.url ||
        progress.audio
      ) {
        audioUrl =
          progress.audioUrl ||
          progress.url ||
          progress.audio;
      }

      const status = String(
        progress.status ||
        progress.state ||
        ""
      ).toLowerCase();

      if (
        status === "completed" ||
        status === "complete" ||
        status === "done" ||
        progress.completed === true
      ) {
        done = true;
      }

      if (
        status === "failed" ||
        status === "error"
      ) {
        throw new Error("Preview failed");
      }
    }

    if (!done) {
      throw new Error("Preview timeout");
    }

    const audio = new Audio(audioUrl);
    audio.preload = "auto";

    audio.onended = () => {
      buttons.forEach(b => {
        b.disabled = false;
        b.classList.remove("is-playing");
      });
    };

    await audio.play();

  } catch (err) {
    console.error("Voice preview error:", err);

    buttons.forEach(b => {
      b.disabled = false;
      b.classList.remove("is-playing");
    });
  }
}
function getRecentVoices() {
  try {
    const data = JSON.parse(localStorage.getItem(RECENT_VOICES_KEY) || "[]");
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
}

function rememberRecentVoice(id) {
  if (!id) return;

  const voice = voices.find(v => v.id === id);
  if (!voice) return;

  const item = {
    ...voice,
    id: voice.id,
    title: voice.title || voice.name || voice.nickname || "Voice"
  };

  let recent = getRecentVoices();

  recent = recent.filter(v => v.id !== item.id);
  recent.unshift(item);
  recent = recent.slice(0, RECENT_VOICES_MAX);

  localStorage.setItem(RECENT_VOICES_KEY, JSON.stringify(recent));
}



function renderRecentVoices() {
  const box = document.getElementById("recentVoicesBox");
  if (!box) return;

  const recent = getRecentVoices()
    .filter(v => v && v.id);

  if (!recent.length) {
    box.innerHTML = "";
    box.style.display = "none";
    return;
  }

  const esc = x => String(x ?? "").replace(/[&<>"']/g, ch => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  }[ch]));

