.voice-info,
.voice-description,
.voice-long-description,
.voice-meta-description,
.voice-result-status,
.voice-load-status,
.voice-load-more,
#loadMoreVoices,
#refreshVoices,
.voice-refresh,
.voice-results-actions,
.voice-pagination,
.voice-loading-status {
  display: none !important;
}

/* أي عناصر قديمة فيها Load More / Refresh */
